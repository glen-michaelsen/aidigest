---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <a href="/" class="brand">AI Digest</a>
      <nav><a href="/">Latest</a></nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Daily AI news, summarized. <a href="https://github.com">Source</a></p>
    </footer>
    <style is:global>
      :root {
        --fg: #111;
        --muted: #666;
        --accent: #0a66ff;
        --bg: #fafafa;
        --card: #fff;
        --border: #e5e5e5;
      }
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        max-width: 880px;
        margin: 0 auto;
        padding: 1.5rem;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.55;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 2rem;
      }
      .brand { font-weight: 700; font-size: 1.25rem; text-decoration: none; color: var(--fg); }
      nav a { color: var(--muted); text-decoration: none; margin-left: 1rem; }
      a { color: var(--accent); }
      footer { margin-top: 4rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.85rem; }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.25rem;
        margin-bottom: 1rem;
      }
      .card h2 { margin: 0 0 0.5rem; font-size: 1.1rem; }
      .card h2 a { color: var(--fg); text-decoration: none; }
      .card h2 a:hover { color: var(--accent); }
      .meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 0.5rem; }
      .brief { margin: 0.5rem 0 0.75rem; }
      .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
      .tag {
        font-size: 0.75rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: #eef3ff;
        color: var(--accent);
        text-decoration: none;
        border: 1px solid #d6e3ff;
      }
      .tag:hover { background: #d6e3ff; }
      .tag-axis { color: var(--muted); margin-right: 0.25rem; }
      .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1rem 0 2rem; }
      h1 { margin-top: 0; }
    </style>
  </body>
</html>
