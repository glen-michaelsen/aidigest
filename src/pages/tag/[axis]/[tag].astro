---
import Layout from "../../../layouts/Layout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { loadArticles, allTags, articlesByTag, type TagAxis } from "../../../lib/articles";

export async function getStaticPaths() {
  const tags = await allTags();
  return tags.map((t) => ({
    params: { axis: t.axis, tag: t.tag },
  }));
}

const { axis, tag } = Astro.params as { axis: TagAxis; tag: string };
const articles = await articlesByTag(axis, tag);
---
<Layout title={`${axis}: ${tag} — AI Digest`}>
  <div class="date-strip">
    <span>{axis} / {tag}</span>
    <span>{articles.length} {articles.length === 1 ? "story" : "stories"}</span>
  </div>

  <p style="margin-bottom: 1.5rem;"><a href="/" style="color: var(--muted); text-decoration: none;">← Back to today</a></p>

  <div class="grid">
    {articles.map((a) => <ArticleCard article={a} />)}
  </div>
</Layout>
