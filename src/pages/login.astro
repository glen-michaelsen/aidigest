---
import Layout from "../layouts/Layout.astro";
const error = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  missing_token: "Missing login token.",
  invalid_token: "Invalid login link.",
  expired_token: "This link has expired. Please request a new one.",
  server_error: "Something went wrong. Please try again.",
};
---
<Layout title="Sign in — AI Digest">
  <div class="login-wrap">
    <h1>Sign in</h1>
    <p class="login-sub">Enter your email and we'll send you a magic link — no password needed.</p>

    {error && <p class="login-error">{errorMessages[error] ?? "An error occurred."}</p>}

    <form class="login-form" id="login-form">
      <input
        type="email"
        id="email-input"
        name="email"
        placeholder="you@example.com"
        required
        autocomplete="email"
      />
      <button type="submit" id="login-submit">Send link</button>
    </form>

    <p class="login-sent" id="login-sent" hidden>
      ✓ Check your inbox — the link expires in 15 minutes.
    </p>
  </div>

  <script>
    const form = document.getElementById("login-form") as HTMLFormElement;
    const sent = document.getElementById("login-sent") as HTMLElement;
    const btn = document.getElementById("login-submit") as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = "Sending…";

      const email = (document.getElementById("email-input") as HTMLInputElement).value;
      const anonId = localStorage.getItem("aidigest:uid") ?? undefined;

      await fetch("/api/auth/send", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ email, anon_id: anonId }),
      });

      form.hidden = true;
      sent.hidden = false;
    });
  </script>
</Layout>

<style>
  .login-wrap {
    max-width: 420px;
    margin: 4rem auto;
  }
  .login-sub {
    color: var(--muted);
    margin-bottom: 2rem;
  }
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .login-form input {
    font-family: inherit;
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    color: var(--fg);
    outline: none;
  }
  .login-form input:focus { border-color: var(--accent); }
  .login-form button {
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border: none;
    border-radius: 8px;
    background: var(--accent);
    color: white;
    cursor: pointer;
  }
  .login-form button:disabled { opacity: 0.6; cursor: default; }
  .login-sent {
    font-size: 1rem;
    color: #2a7a4b;
    background: #d6f0e0;
    border-radius: 8px;
    padding: 1rem;
  }
  .login-error {
    color: #b03030;
    background: #fde8e8;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
</style>
