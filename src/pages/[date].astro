---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { allDates, articlesByDate } from "../lib/articles";

export async function getStaticPaths() {
  const dates = await allDates();
  return dates.map((date) => ({ params: { date } }));
}

const { date } = Astro.params as { date: string };
const articles = await articlesByDate(date);

const dateObj = new Date(date + "T00:00:00Z");
const dateLabel = dateObj.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const yesterday = new Date();
yesterday.setUTCDate(yesterday.getUTCDate() - 1);
const isYesterday = date === yesterday.toISOString().slice(0, 10);
const [hero, ...rest] = articles;
---
<Layout title={`${dateLabel} — AI Digest`} currentDate={date}>
  <div class="date-strip">
    <span>{isYesterday ? "Yesterday" : ""} — {dateLabel}</span>
    <span>{articles.length} {articles.length === 1 ? "story" : "stories"}</span>
  </div>

  <div class="user-bar">
    <button type="button" id="liked-only-toggle" class="user-bar-btn">☆ Liked only</button>
    <form class="user-bar-search" action="/search" method="get">
      <input type="search" name="q" class="user-bar-search-input" placeholder="Search all articles…" autocomplete="off" />
      <button type="submit" class="user-bar-search-btn" aria-label="Search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </form>
  </div>

  {articles.length === 0 ? (
    <div class="card">
      <h2>No articles for this date</h2>
      <p class="brief">Try another date from the calendar.</p>
    </div>
  ) : (
    <>
      {hero && <ArticleCard article={hero} hero={true} />}
      <div class="grid">
        {rest.map((a) => <ArticleCard article={a} />)}
      </div>
    </>
  )}
</Layout>
