---
import Layout from "../layouts/Layout.astro";
// Pass today so the calendar button appears on the search page too,
// allowing users to change their date range without going back.
const todayStr = new Date().toISOString().slice(0, 10);
---
<Layout title="Search — AI Watchly" currentDate={todayStr}>
  <div class="search-page">
    <form class="search-form" id="search-form" action="/search">
      <input
        type="search"
        id="search-input"
        name="q"
        class="search-input"
        placeholder="Search headlines and summaries…"
        autofocus
        autocomplete="off"
      />
      <button type="submit" class="search-btn">Search</button>
    </form>

    <div id="search-status" class="search-status"></div>
    <div id="search-results"></div>
  </div>
</Layout>

<script>
  interface Article {
    id: string;
    title: string;
    brief: string;
    source: string;
    publishedAt: string;
    category: string;
    url: string;
    tags: Record<string, string[]>;
  }

  function formatDate(iso: string): string {
    const d = new Date(iso + (iso.length === 10 ? "T00:00:00Z" : ""));
    return d.toLocaleDateString("en-US", {
      weekday: "long", year: "numeric", month: "long", day: "numeric", timeZone: "UTC"
    });
  }

  function dateKey(iso: string): string {
    return iso.slice(0, 10);
  }

  function highlight(text: string, query: string): string {
    if (!query) return escapeHtml(text);
    const words = query.trim().split(/\s+/).filter(Boolean).map(escapeRegex);
    if (!words.length) return escapeHtml(text);
    return escapeHtml(text).replace(
      new RegExp(`(${words.map(escapeHtml).join("|")})`, "gi"),
      "<mark>$1</mark>"
    );
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function escapeRegex(s: string): string {
    return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function fmtShort(iso: string): string {
    return new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
      month: "short", day: "numeric", timeZone: "UTC"
    });
  }

  function renderResults(articles: Article[], query: string, fromDate = "", toDate = ""): void {
    const statusEl  = document.getElementById("search-status")!;
    const resultsEl = document.getElementById("search-results")!;

    const hasQuery = query.trim().length > 0;
    const hasRange = !!(fromDate && toDate);

    if (!hasQuery && !hasRange) {
      statusEl.textContent = "";
      resultsEl.innerHTML  = "";
      return;
    }

    if (articles.length === 0) {
      statusEl.textContent = hasQuery
        ? `No results for "${query}"${hasRange ? " in selected range" : ""}`
        : "No articles found in selected range";
      resultsEl.innerHTML = "";
      return;
    }

    // Build status line
    const rangeLabel = hasRange ? ` · ${fmtShort(fromDate)} – ${fmtShort(toDate)}` : "";
    statusEl.textContent = hasQuery
      ? `${articles.length} result${articles.length === 1 ? "" : "s"} for "${query}"${rangeLabel}`
      : `${articles.length} article${articles.length === 1 ? "" : "s"}${rangeLabel}`;

    // Group by date
    const byDate = new Map<string, Article[]>();
    for (const a of articles) {
      const key = dateKey(a.publishedAt);
      if (!byDate.has(key)) byDate.set(key, []);
      byDate.get(key)!.push(a);
    }

    let html = "";
    for (const [date, group] of byDate) {
      html += `<div class="search-date-group">
        <div class="date-strip"><span>${formatDate(date)}</span><span>${group.length} ${group.length === 1 ? "story" : "stories"}</span></div>
        <div class="search-cards">`;
      for (const a of group) {
        const cat = a.category ?? "default";
        html += `<article class="card search-result-card" data-article-id="${escapeHtml(a.id)}">
          <div class="card-head">
            <a class="pill" data-cat="${escapeHtml(cat)}" href="/tag/category/${escapeHtml(cat)}">${escapeHtml(cat.replace(/-/g, " "))}</a>
          </div>
          <h2><a href="${escapeHtml(a.url)}" target="_blank" rel="noopener">${highlight(a.title, query)}</a></h2>
          <p class="brief">${highlight(a.brief, query)}</p>
          <div class="card-foot">
            <span>${escapeHtml(a.source)} · ${new Date(a.publishedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
            <a href="${escapeHtml(a.url)}" target="_blank" rel="noopener">Read →</a>
          </div>
        </article>`;
      }
      html += `</div></div>`;
    }

    resultsEl.innerHTML = html;
  }

  async function searchOrBrowse(query: string, fromDate = "", toDate = ""): Promise<void> {
    const statusEl = document.getElementById("search-status")!;
    const hasQuery = query.trim().length > 0;
    const hasRange = !!(fromDate && toDate);

    if (!hasQuery && !hasRange) {
      renderResults([], query, fromDate, toDate);
      return;
    }

    statusEl.textContent = hasQuery ? "Searching…" : "Loading…";

    let index: Article[];
    try {
      const res = await fetch("/search.json");
      index = await res.json();
    } catch {
      statusEl.textContent = "Failed to load search index.";
      return;
    }

    let filtered = index;

    // Filter by date range
    if (hasRange) {
      filtered = filtered.filter((a) => {
        const d = a.publishedAt.slice(0, 10);
        return d >= fromDate && d <= toDate;
      });
    }

    // Filter by text query
    if (hasQuery) {
      const words = query.trim().toLowerCase().split(/\s+/).filter(Boolean);
      filtered = filtered.filter((a) => {
        const haystack = (a.title + " " + a.brief).toLowerCase();
        return words.every((w) => haystack.includes(w));
      });
    }

    renderResults(filtered, query, fromDate, toDate);
  }

  // ─── Init ─────────────────────────────────────────────────────────────────

  const params       = new URLSearchParams(window.location.search);
  const initialQuery = params.get("q")    ?? "";
  const initialFrom  = params.get("from") ?? "";
  const initialTo    = params.get("to")   ?? "";

  const inputEl = document.getElementById("search-input") as HTMLInputElement;
  if (initialQuery) inputEl.value = initialQuery;

  // Update the header nav label to reflect the browsed range
  if (initialFrom && initialTo) {
    const navLabelEl = document.getElementById("cal-nav-label");
    if (navLabelEl) {
      const opts: Intl.DateTimeFormatOptions = { month: "short", day: "numeric", timeZone: "UTC" };
      const f = new Date(initialFrom + "T00:00:00Z").toLocaleDateString("en-US", opts);
      const t = new Date(initialTo   + "T00:00:00Z").toLocaleDateString("en-US", opts);
      navLabelEl.textContent = `${f} – ${t}`;
    }
  }

  if (initialQuery || initialFrom) {
    searchOrBrowse(initialQuery, initialFrom, initialTo);
  }

  // Live search as user types (debounced)
  let debounceTimer: ReturnType<typeof setTimeout>;
  inputEl.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      const q = inputEl.value.trim();
      const url = new URL(window.location.href);
      if (q) url.searchParams.set("q", q); else url.searchParams.delete("q");
      history.replaceState({}, "", url);
      searchOrBrowse(q, initialFrom, initialTo);
    }, 250);
  });

  // Prevent full page reload on form submit
  document.getElementById("search-form")!.addEventListener("submit", (e) => {
    e.preventDefault();
    searchOrBrowse(inputEl.value.trim(), initialFrom, initialTo);
  });
</script>

<style>
  .search-page { max-width: 800px; margin: 0 auto; }

  .search-form {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .search-input {
    flex: 1;
    font-family: inherit;
    font-size: 1rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
    color: var(--fg);
    outline: none;
    transition: border-color 0.15s;
  }
  .search-input:focus { border-color: var(--accent); }
  .search-input::placeholder { color: var(--muted); }

  .search-btn {
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.65rem 1.25rem;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .search-btn:hover { background: var(--accent-strong); }

  .search-status {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
    min-height: 1.2em;
  }

  /* These classes are injected by JS so must opt out of Astro scoping */
  :global(.search-date-group) { margin-bottom: 1rem; }
  :global(.search-date-group + .search-date-group) { padding-top: 3rem; }

  :global(.search-cards) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  :global(.search-result-card) { min-height: unset; }
  :global(.search-result-card h2) { font-size: 1.1rem; }
  :global(.search-result-card h2 a) { color: var(--fg); text-decoration: none; }
  :global(.search-result-card h2 a:hover) { color: var(--accent); }

  :global(mark) {
    background: #ffe08a;
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
</style>
