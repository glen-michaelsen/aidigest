---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { loadArticles } from "../lib/articles";

const articles = await loadArticles();
const today = new Date().toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const [hero, ...rest] = articles;
---
<Layout title="AI Digest">
  <div class="date-strip">
    <span>{today}</span>
    <span>{articles.length} {articles.length === 1 ? "story" : "stories"}</span>
  </div>

  {articles.length === 0 ? (
    <div class="card">
      <h2>No articles yet</h2>
      <p class="brief">Run <code>npm run ingest</code> or trigger the GitHub Action to populate.</p>
    </div>
  ) : (
    <>
      {hero && <ArticleCard article={hero} hero={true} />}
      <div class="grid">
        {rest.map((a) => <ArticleCard article={a} />)}
      </div>
    </>
  )}
</Layout>
