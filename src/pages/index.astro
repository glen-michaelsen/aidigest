---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { loadArticles } from "../lib/articles";

const articles = await loadArticles();

// Always show yesterday's date — the ingest captures that day's news at 23:00 UTC.
const yesterday = new Date();
yesterday.setUTCDate(yesterday.getUTCDate() - 1);
const dateLabel = yesterday.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const [hero, ...rest] = articles;
---
<Layout title="AI Digest">
  <div class="date-strip">
    <span>Yesterday — {dateLabel}</span>
    <span>{articles.length} {articles.length === 1 ? "story" : "stories"}</span>
  </div>

  <div class="user-bar">
    <button type="button" id="liked-only-toggle" class="user-bar-btn">☆ Liked only</button>
    <div class="saved-filters">
      <span class="saved-label">Saved views:</span>
      <span id="saved-filters-list" class="saved-list">
        <span class="muted-note">Loading…</span>
      </span>
    </div>
  </div>

  {articles.length === 0 ? (
    <div class="card">
      <h2>No articles yet</h2>
      <p class="brief">Run <code>npm run ingest</code> or trigger the GitHub Action to populate.</p>
    </div>
  ) : (
    <>
      {hero && <ArticleCard article={hero} hero={true} />}
      <div class="grid">
        {rest.map((a) => <ArticleCard article={a} />)}
      </div>
    </>
  )}
</Layout>
