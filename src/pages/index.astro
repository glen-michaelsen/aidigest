---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { articlesByDate, yesterdayUTC, loadArticles } from "../lib/articles";

const yesterdayStr = yesterdayUTC();
const articles = await articlesByDate(yesterdayStr);

const dateLabel = new Date(yesterdayStr + "T00:00:00Z").toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const [hero, ...rest] = articles;

// Hot topics: count categories across the last 7 days
const allArticles = await loadArticles(); // cached — no extra I/O
const cutoff = new Date();
cutoff.setUTCDate(cutoff.getUTCDate() - 7);
const cutoffStr = cutoff.toISOString().slice(0, 10);

const catCounts = new Map<string, number>();
for (const a of allArticles) {
  if (a.publishedAt.slice(0, 10) < cutoffStr) continue;
  const cat = a.tags.category?.[0];
  if (cat) catCounts.set(cat, (catCounts.get(cat) ?? 0) + 1);
}
const hotTopics = [...catCounts.entries()].sort((a, b) => b[1] - a[1]);
---
<Layout title="AI Watchly" currentDate={yesterdayStr}>
  {hotTopics.length > 0 && (
    <div class="hot-topics">
      <span class="hot-topics-label">Hot topics</span>
      <div class="hot-topics-pills">
        {hotTopics.map(([cat, count]) => (
          <a class="pill hot-pill" data-cat={cat} href={`/tag/category/${cat}`}>
            {cat.replace(/-/g, " ")}
            <span class="hot-count">{count}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="date-strip">
    <span>Yesterday — {dateLabel}</span>
    <span>{articles.length} {articles.length === 1 ? "story" : "stories"}</span>
  </div>

  <div class="user-bar">
    <button type="button" id="liked-only-toggle" class="user-bar-btn">☆ Liked only</button>
    <form class="user-bar-search" action="/search" method="get">
      <input type="search" name="q" class="user-bar-search-input" placeholder="Search all articles…" autocomplete="off" />
      <button type="submit" class="user-bar-search-btn" aria-label="Search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </form>
  </div>

  {articles.length === 0 ? (
    <div class="card">
      <h2>No articles yet</h2>
      <p class="brief">Run <code>npm run ingest</code> or trigger the GitHub Action to populate.</p>
    </div>
  ) : (
    <>
      {hero && <ArticleCard article={hero} hero={true} />}
      <div class="grid">
        {rest.map((a) => <ArticleCard article={a} />)}
      </div>
    </>
  )}
</Layout>

<style>
  .hot-topics {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }
  .hot-topics-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .hot-topics-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .hot-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: opacity 0.15s, transform 0.15s;
  }
  .hot-pill:hover { opacity: 0.8; transform: translateY(-1px); }
  .hot-count {
    font-size: 0.6rem;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.12);
    border-radius: 999px;
    padding: 0.1rem 0.4rem;
    letter-spacing: 0;
  }
</style>
