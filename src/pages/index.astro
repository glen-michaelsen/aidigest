---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { articlesByDate, yesterdayUTC } from "../lib/articles";

const yesterdayStr = yesterdayUTC();
const articles = await articlesByDate(yesterdayStr);

const dateLabel = new Date(yesterdayStr + "T00:00:00Z").toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const [hero, ...rest] = articles;
---
<Layout title="AI Digest" currentDate={yesterdayStr}>
  <div class="date-strip">
    <span>Yesterday — {dateLabel}</span>
    <span>{articles.length} {articles.length === 1 ? "story" : "stories"}</span>
  </div>

  <div class="user-bar">
    <button type="button" id="liked-only-toggle" class="user-bar-btn">☆ Liked only</button>
    <form class="user-bar-search" action="/search" method="get">
      <input type="search" name="q" class="user-bar-search-input" placeholder="Search all articles…" autocomplete="off" />
      <button type="submit" class="user-bar-search-btn" aria-label="Search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </form>
  </div>

  {articles.length === 0 ? (
    <div class="card">
      <h2>No articles yet</h2>
      <p class="brief">Run <code>npm run ingest</code> or trigger the GitHub Action to populate.</p>
    </div>
  ) : (
    <>
      {hero && <ArticleCard article={hero} hero={true} />}
      <div class="grid">
        {rest.map((a) => <ArticleCard article={a} />)}
      </div>
    </>
  )}
</Layout>
