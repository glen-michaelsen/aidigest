---
import type { Article } from "../lib/articles";
import { formatDate } from "../lib/articles";

interface Props {
  article: Article;
  hero?: boolean;
}
const { article, hero = false } = Astro.props;
const primaryCat = article.tags.category?.[0] ?? "default";
const primaryDomain = article.tags.domain?.[0];
const cardClass = hero ? "card card--hero" : "card";
---
<article class={cardClass}>
  <div class="card-head">
    <a class="pill" data-cat={primaryCat} href={`/tag/category/${primaryCat}`}>
      {primaryCat.replace("-", " ")}
    </a>
    {primaryDomain && (
      <a class="pill" href={`/tag/domain/${primaryDomain}`} style="background: var(--bg-alt); border: 1px solid var(--border);">
        {primaryDomain.replace("-", " ")}
      </a>
    )}
  </div>
  <h2><a href={article.url} target="_blank" rel="noopener">{article.title}</a></h2>
  <p class="brief">{article.brief}</p>
  <div class="card-foot">
    <span>{article.source} · {formatDate(article.publishedAt)}</span>
    <a href={article.url} target="_blank" rel="noopener">Read →</a>
  </div>
</article>
